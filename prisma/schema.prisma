// Prisma Schema for Maarif Akademi (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum TeacherStatus {
  PENDING_EMAIL
  PENDING_ADMIN_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique // Öğretmen/admin için zorunlu, öğrenci için opsiyonel
  firstName String   @default("")
  lastName  String   @default("")
  name      String
  password  String?  // Giriş şifresi (Öğretmen, Admin veya Öğrenci şifresi)
  gender    String?  // İsteğe bağlı cinsiyet
  role          Role     @default(STUDENT)
  accountStatus String   @default("aktif") // "aktif" | "beklemede"
  isKvkkAccepted Boolean  @default(false)   // KVKK & Taahhütname onay durumu
  kvkkAcceptedAt DateTime?                 // KVKK onay tarihi
  avatar        String?
  lastLoginAt   DateTime?
  loginCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  loginLogs      LoginLog[]

  @@map("users")
}

model TeacherProfile {
  id               String        @id @default(cuid())
  userId           String        @unique
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone            String?
  city             String        // İl
  district         String        // İlçe
  school           String        // Okul Adı
  branch           String        @default("Matematik") // Branş
  principalName    String?       // Okul Müdürü Adı Soyadı
  status           TeacherStatus @default(PENDING_EMAIL)
  verificationCode String?       // 6 haneli e-posta güvenlik kodu
  verifiedAt       DateTime?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  classrooms       Classroom[]
  students         StudentProfile[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentNumber String   // Okul No (Örn: 104)
  gradeLevel    Int      @default(5)
  classSection  String   @default("5-A") // Şube (5-A, 5-B vb.)
  classCode     String?  // 6 haneli benzersiz sınıf kodu (Örn: MRF5A1)
  city          String
  district      String
  school        String
  teacherId     String?
  teacher       TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  points        Int      @default(0) // XP Puanı
  subjectPoints Json?    // Branş bazlı XP { "Matematik": 150, "Fen Bilimleri": 100 }
  isPasswordChangedByStudent Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  badges           StudentBadge[]
  progresses       OutcomeProgress[]
  selfAssessments  SelfAssessmentSubmission[]
  learningJournals LearningJournal[]
  boardParticipations BoardParticipation[]

  @@unique([school, classSection, studentNumber])
  @@map("student_profiles")
}

model Classroom {
  id         String   @id @default(cuid())
  name       String   // 5-A
  code       String?  @unique // 6 haneli benzersiz sınıf kodu (örn: MRF5A1)
  gradeLevel Int      @default(5)
  city       String?  // İl
  district   String?  // İlçe
  school     String   // Okul Adı
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([city, district, school])
  @@map("classrooms")
}

model Badge {
  id             String   @id @default(cuid())
  slug           String   @unique // 'first-step', 'geometry-master'
  title          String
  description    String
  icon           String
  pointsRequired Int      @default(50)
  createdAt      DateTime @default(now())

  studentBadges  StudentBadge[]

  @@map("badges")
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge          @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt  DateTime       @default(now())

  @@unique([studentId, badgeId])
  @@map("student_badges")
}

model OutcomeProgress {
  id             String   @id @default(cuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  outcomeCode    String   // 'MAT.5.3.1', 'MAT.5.3.2'
  score          Int      @default(0)
  reflectionNote String?
  completedAt    DateTime @default(now())

  @@map("outcome_progresses")
}

model SelfAssessmentSubmission {
  id               String   @id @default(cuid())
  studentId        String?
  studentName      String
  studentNumber    String?
  gradeLevel       Int      @default(5)
  classSection     String   // 5-A, 5-B, 5-C, 5-D
  school           String?
  teacherId        String?
  outcomeId        String   // MAT.5.3.3
  outcomeCode      String   // MAT.5.3.3
  outcomeTitle     String
  subject          String?  // Matematik, Fen Bilimleri vb.
  ratings          Json     // { "c1": 4, "c2": 3, "c3": 4, ... }
  totalScore       Int
  maxScore         Int      @default(20)
  percentage       Int
  performanceLevel String   // "Mükemmel", "Başarılı", "Orta", "Geliştirilmeli"
  studentNote      String?
  teacherFeedback  String?
  submittedAt      DateTime @default(now())

  student          StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([outcomeCode, classSection])
  @@index([classSection])
  @@map("self_assessment_submissions")
}

model LearningJournal {
  id                String   @id @default(cuid())
  studentId         String?
  studentName       String
  studentNumber     String?
  gradeLevel        Int      @default(5)
  classSection      String   // 5-A, 6-A
  school            String?
  outcomeId         String   // MAT.6.1.3
  outcomeCode       String   // MAT.6.1.3
  outcomeTitle      String
  subject           String?  // Matematik, Fen Bilimleri vb.
  prompt            String   // SDB1.3 Yansıtma sorusu
  studentReflection String   // Öğrenci cevabı
  teacherFeedback   String?
  teacherLiked      Boolean  @default(false)
  submittedAt       DateTime @default(now())

  student           StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([outcomeCode, classSection])
  @@index([classSection])
  @@map("learning_journals")
}

model PeerEvaluationSubmission {
  id                   String   @id @default(cuid())
  evaluatorStudentId   String?
  evaluatorStudentName String
  evaluatorStudentNumber String?
  targetStudentId      String?
  targetStudentName    String
  targetStudentNumber  String?
  targetAvatar         String?
  groupId              String?
  groupName            String?
  gradeLevel           Int      @default(5)
  classSection         String   // 5-A, 5-B
  school               String?
  outcomeId            String   // MAT.5.3.3
  outcomeCode          String   // MAT.5.3.3
  outcomeTitle         String
  ratings              Json     // { "c1": 4, "c2": 3, ... }
  totalScore           Int
  maxScore             Int      @default(20)
  percentage           Int
  performanceLevel     String   // "Mükemmel", "Başarılı", "Orta", "Geliştirilmeli"
  evaluatorNote        String?
  submittedAt          DateTime @default(now())

  @@index([outcomeCode, classSection])
  @@index([targetStudentId])
  @@index([evaluatorStudentId])
  @@map("peer_evaluation_submissions")
}

model BoardParticipation {
  id            String   @id @default(cuid())
  studentId     String?
  studentName   String
  studentNumber String?
  classSection  String   // 5-A, 5-B
  school        String?
  teacherId     String?
  teacherName   String?
  activityType  String   // 'game' | 'test' | 'rubric' | 'journal'
  activityTitle String
  outcomeCode   String?
  subject       String?  // Matematik, Fen Bilimleri vb.
  score         Int?
  maxScore      Int?
  xpEarned      Int      @default(0)
  timestamp     DateTime @default(now())

  student       StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([classSection])
  @@index([studentNumber])
  @@index([studentId])
  @@map("board_participations")
}

model LoginLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceCategory String   @default("desktop") // desktop, smartboard, mobile, windows
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

model Message {
  id                   String   @id @default(cuid())
  senderId             String
  senderName           String
  senderRole           String   // admin, teacher, student
  senderAvatar         String?
  receiverId           String
  receiverName         String
  receiverRole         String   // admin, teacher, student
  receiverClassSection String?
  title                String
  content              String   @db.VarChar(500)
  read                 Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([receiverId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

